<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS AutoClick"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Posizione simulata + pressione automatica"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="POSIZIONE GPS MANUALE"
            android:textColor="@color/cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/latInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/cyan"
            android:hint="Latitudine"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/white"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/lonInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/cyan"
            android:hint="Longitudine"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/white"
            android:textColorHint="@color/muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startGpsBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Avvia GPS" />

            <Button
                android:id="@+id/stopGpsBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Stop GPS" />
        </LinearLayout>

        <Button
            android:id="@+id/mockSettingsBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="Impostazioni posizione fittizia" />

        <TextView
            android:id="@+id/gpsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GPS simulato: fermo"
            android:textColor="@color/muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="AUTOMAZIONE MANUALE"
            android:textColor="@color/cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pickAppBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="Scegli app" />

        <TextView
            android:id="@+id/selectedAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nessuna app selezionata"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selectedPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pacchetto: —"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/buttonTextInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/cyan"
            android:hint="Testo pulsante, es. USCITA"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@color/muted" />

        <Button
            android:id="@+id/accessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Attiva servizio Accessibilità" />

        <Button
            android:id="@+id/launchAutoBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:text="APRI APP E PREMI IL TASTO"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Automazione: pronta"
            android:textColor="@color/muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="4 AUTOMAZIONI PROGRAMMATE"
            android:textColor="@color/cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ogni automazione può avere ora, app, tasto e coordinate diverse."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/automationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/exactAlarmBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Consenti orari precisi" />

        <Button
            android:id="@+id/saveSchedulesBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:text="SALVA E PROGRAMMA I 4 ORARI"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scheduleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Programmazione: non salvata"
            android:textColor="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingBottom="24dp"
            android:text="Nota: Android o l'app scelta possono limitare avvii automatici, posizioni fittizie o click tramite Accessibilità."
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
